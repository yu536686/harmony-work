<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\src-tauri\icons\icon.ico</ApplicationIcon>
    <AssemblyName>Xiaoheng-WorkBuddy-Setup</AssemblyName>
    <RootNamespace>WorkBuddyBootstrapper</RootNamespace>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <PayloadDirectory Condition="'$(PayloadDirectory)' == ''">$(MSBuildProjectDirectory)\..\.build\payload</PayloadDirectory>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="..\..\src-tauri\icons\128x128.png" Link="Assets\brand.png" />
    <Content Include="$(PayloadDirectory)\**\*" Link="payload\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>
