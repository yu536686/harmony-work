<Window x:Class="WorkBuddyBootstrapper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="安装 Harmony Work" Height="700" Width="540" MinHeight="700" MinWidth="540"
        WindowStyle="None" ResizeMode="NoResize" Background="#F7F6FC" FontFamily="Microsoft YaHei UI">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="44" CornerRadius="16" GlassFrameThickness="0" ResizeBorderThickness="0" />
  </shell:WindowChrome.WindowChrome>
  <Border Margin="1" Background="#FCFBFF" CornerRadius="15" BorderBrush="#E1DDF1" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="44" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Margin="20,0,14,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Image Width="19" Height="19" Source="pack://application:,,,/Assets/brand.png" Stretch="Uniform" />
          <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Foreground="#6A6478" FontSize="12" Text="Harmony Work 安装器" />
        </StackPanel>
        <Button HorizontalAlignment="Right" Width="28" Height="28" BorderThickness="0" Background="Transparent"
                shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="关闭安装器"
                Foreground="#9992AB" FontSize="18" Content="×" Click="Close_Click" />
      </Grid>

      <Grid Grid.Row="1" Margin="44,8,44,32">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" VerticalAlignment="Center">
          <Border Width="102" Height="102" CornerRadius="27" Background="#F0ECFF" BorderBrush="#DED5FF" BorderThickness="1" HorizontalAlignment="Center">
            <Image Source="pack://application:,,,/Assets/brand.png" Stretch="Uniform" Margin="14" />
          </Border>
          <TextBlock Margin="0,18,0,0" HorizontalAlignment="Center" FontSize="30" FontWeight="SemiBold">
            <Run Foreground="#272334" Text="Harmony " /><Run Foreground="#7A57EB" Text="Work" />
          </TextBlock>
          <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center" FontSize="14" Foreground="#79728B" Text="让创作、协作与执行在一个工作台完成" />

          <Border x:Name="StatusPanel" Margin="0,30,0,0" Padding="16" Background="#F4F1FF" BorderBrush="#E6E0FA" BorderThickness="1" CornerRadius="10" Visibility="Visible">
            <StackPanel>
              <DockPanel>
                <TextBlock x:Name="StatusTitle" FontSize="14" FontWeight="SemiBold" Foreground="#302B40" Text="正在准备安装" />
                <TextBlock x:Name="ProgressText" DockPanel.Dock="Right" FontSize="12" Foreground="#807798" Text="0%" />
              </DockPanel>
              <ProgressBar x:Name="InstallProgress" Height="6" Margin="0,12,0,0" Minimum="0" Maximum="100" Value="0" Foreground="#7654E8" Background="#DDD7F1" />
              <TextBlock x:Name="StatusDetail" Visibility="Collapsed" FontSize="12" Foreground="#79728B" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Button x:Name="InstallButton" Margin="0,30,0,0" Height="48" Background="#7654E8" Foreground="White" BorderThickness="0"
                  FontSize="15" FontWeight="SemiBold" Content="正在加载…" IsEnabled="False" Click="Install_Click" />

          <Button x:Name="CustomizeButton" Margin="0,14,0,0" Background="Transparent" BorderThickness="0" Foreground="#615977"
                  FontSize="13" Content="自定义安装⌄" Click="ToggleCustomize_Click" />

          <StackPanel x:Name="CustomizePanel" Visibility="Collapsed" Margin="0,10,0,0">
            <TextBlock FontSize="12" Foreground="#746C87" Text="安装位置" />
            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="42" /></Grid.ColumnDefinitions>
              <TextBox x:Name="InstallPathTextBox" Grid.Column="0" Height="38" Padding="11,7" BorderBrush="#DDD6EE" Background="#F7F5FC" Foreground="#514A62" />
              <Button Grid.Column="1" Margin="7,0,0,0" Height="38" Background="#F0ECFA" BorderBrush="#DDD6EE" Content="…" Click="ChoosePath_Click" />
            </Grid>
            <WrapPanel Margin="0,14,0,0">
              <CheckBox x:Name="DesktopShortcutCheckBox" Margin="0,0,20,10" IsChecked="True" Content="创建桌面快捷方式" />
              <CheckBox x:Name="StartMenuShortcutCheckBox" Margin="0,0,20,10" IsChecked="True" Content="添加到开始菜单" />
              <CheckBox x:Name="StartupCheckBox" Margin="0,0,20,10" Content="开机自动启动" />
            </WrapPanel>
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1">
          <CheckBox x:Name="TermsCheckBox" FontSize="12" Foreground="#625B70" IsChecked="False">
            <TextBlock>我已查看 <Hyperlink NavigateUri="https://www.harmonywork.com.cn/legal/terms" RequestNavigate="LegalLink_RequestNavigate" Foreground="#7654E8">用户协议</Hyperlink> 和 <Hyperlink NavigateUri="https://www.harmonywork.com.cn/legal/privacy" RequestNavigate="LegalLink_RequestNavigate" Foreground="#7654E8">隐私条款</Hyperlink> 页面</TextBlock>
          </CheckBox>
          <TextBlock x:Name="ErrorText" Margin="0,10,0,0" FontSize="12" Foreground="#B5382D" TextWrapping="Wrap" Visibility="Collapsed" />
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
