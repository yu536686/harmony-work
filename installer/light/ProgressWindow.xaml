<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Harmony Work 更新" Width="500" Height="346" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize"
 AllowsTransparency="True" Background="Transparent" FontFamily="Microsoft YaHei UI" FontSize="12" ShowInTaskbar="True">
 <Window.Resources>
  <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/><SolidColorBrush x:Key="Text" Color="#202536"/>
  <SolidColorBrush x:Key="Muted" Color="#667085"/><SolidColorBrush x:Key="Line" Color="#E4E4E8"/>
  <SolidColorBrush x:Key="Accent" Color="#6658F6"/><SolidColorBrush x:Key="Soft" Color="#F3F2FF"/>
  <Style TargetType="Button">
   <Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="16,8"/><Setter Property="Foreground" Value="{DynamicResource Text}"/>
   <Setter Property="Background" Value="{DynamicResource Soft}"/><Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.78"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ProgressBar"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar">
   <Grid ClipToBounds="True"><Border Background="{DynamicResource Soft}" CornerRadius="3"/><Border x:Name="PART_Track"/>
    <Border x:Name="PART_Indicator" Background="{DynamicResource Accent}" CornerRadius="3" HorizontalAlignment="Left"/>
    <Border x:Name="Pulse" Visibility="Collapsed" Width="90" Background="{DynamicResource Accent}" CornerRadius="3" HorizontalAlignment="Left"><Border.RenderTransform><TranslateTransform/></Border.RenderTransform></Border>
   </Grid>
   <ControlTemplate.Triggers><Trigger Property="IsIndeterminate" Value="True">
    <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed"/><Setter TargetName="Pulse" Property="Visibility" Value="Visible"/>
    <Trigger.EnterActions><BeginStoryboard x:Name="PulseMotion"><Storyboard RepeatBehavior="Forever"><DoubleAnimation Storyboard.TargetName="Pulse" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="-90" To="430" Duration="0:0:1.5"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
    <Trigger.ExitActions><StopStoryboard BeginStoryboardName="PulseMotion"/></Trigger.ExitActions>
   </Trigger></ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Border Margin="12" CornerRadius="20" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
  <Border.Effect><DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.13" Color="#292642"/></Border.Effect>
  <Grid Margin="28,18,28,22">
   <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid x:Name="DragRegion">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image x:Name="BrandIcon" Width="20" Height="20"/><TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Text}" FontWeight="SemiBold" Text="Harmony Work"/></StackPanel>
    <Button x:Name="MinimizeButton" HorizontalAlignment="Right" Padding="10,2" Background="Transparent" Foreground="{DynamicResource Muted}" Content="−" ToolTip="最小化" AutomationProperties.Name="最小化更新窗口"/>
   </Grid>
   <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,16,0,18">
    <TextBlock x:Name="Heading" Text="正在更新" FontSize="23" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
    <TextBlock x:Name="VersionLabel" Margin="0,8,0,0" Foreground="{DynamicResource Muted}"/>
    <Grid Margin="0,22,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock x:Name="StageText" Text="正在准备更新" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"/>
     <TextBlock x:Name="PercentText" Grid.Column="1" Margin="12,0,0,0" Foreground="{DynamicResource Muted}"/>
    </Grid>
    <ProgressBar x:Name="Progress" Height="5" Minimum="0" Maximum="100" Value="0"/>
    <TextBlock x:Name="HintText" Margin="0,12,0,0" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Text="完成后将自动打开客户端，请暂时不要手动启动。"/>
   </StackPanel>
   <StackPanel x:Name="FailureActions" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Visibility="Collapsed">
    <Button x:Name="LogButton" Margin="0,0,8,0" Content="查看日志"/>
    <Button x:Name="CloseButton" Margin="0,0,8,0" Content="关闭"/>
    <Button x:Name="RetryButton" Background="{DynamicResource Accent}" Foreground="White" Content="重试"/>
   </StackPanel>
  </Grid>
 </Border>
</Window>
