{
  "name": "xiaoheng-workbuddy",
  "private": true,
  "version": "1.0.0-beta.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run stage:codex && npm run stage:mcp-host && npm run build:artifact-runtime && npm run build:web",
    "build:artifact-runtime": "npm run typecheck:artifact-runtime && node scripts/build-artifact-runtime.mjs",
    "build:web": "tsc && vite build",
    "build:tauri": "npm run build",
    "preview": "vite preview",
    "stage:codex": "node scripts/stage-codex-sidecar.mjs",
    "stage:mcp-host": "node scripts/stage-workbuddy-mcp-host.mjs",
    "tauri": "tauri",
    "test": "vitest run",
    "test:codex-sdk": "node --test scripts/codex-sdk-runner.test.mjs",
    "test:codex-sidecar": "node --test scripts/stage-codex-sidecar.test.mjs",
    "test:mcp-host": "node --test scripts/stage-workbuddy-mcp-host.test.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:artifact-runtime": "vitest run --config artifact-runtime/vitest.config.ts",
    "typecheck:artifact-runtime": "tsc -p artifact-runtime/tsconfig.json"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@openai/codex-sdk": "0.149.0",
    "@reduxjs/toolkit": "^2.3.0",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-notification": "^2.0.1",
    "@tauri-apps/plugin-shell": "^2.0.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "highlight.js": "^11.11.1",
    "i18next": "^25.8.13",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "mermaid": "^11.12.3",
    "monaco-editor": "^0.55.1",
    "pptxgenjs": "^4.0.1",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^16.5.4",
    "react-markdown": "^10.1.0",
    "react-redux": "^9.1.2",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^0.1.95",
    "@tauri-apps/cli": "^2.8.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.0.18",
    "esbuild": "^0.25.12",
    "happy-dom": "^20.7.0",
    "jsdom": "^28.1.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^4.0.18"
  }
}
